{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "killmutants-site",
  "compatibility_date": "2026-09-01",

  // killmutants.io is attached as a Custom Domain (apex only, no www — same
  // approach as justdummies.io). Turning this off is the only way to make
  // that the site's one address rather than one of two: left on, the same
  // bytes stay reachable at killmutants-site.<subdomain>.workers.dev too,
  // which search engines index and links can point at, none of it intended.
  "workers_dev": false,

  // Pure static assets — no Worker script. There is nothing here yet that
  // needs to run server-side (no analytics collector, no dynamic route).
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page"
  }
}
