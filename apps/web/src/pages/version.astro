---
import "../styles/base.css";
import Header from "../components/Header.astro";
import ReleaseCard from "../components/ReleaseCard.astro";
import { commitUrl, version } from "../version";
import { releaseUrl, releasesListUrl, siteRelease } from "../site-release";

const NOTHING = "#null";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Version — KillMutants</title>
    <meta name="description" content="What this deployment of killmutants.io is, and what it last shipped." />
  </head>
  <body>
    <div style="position: relative; height: 300px; overflow: hidden;">
      <img
        src="/images/version-hero.jpg"
        alt=""
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: left center; opacity: 0.75;"
      />
      <div
        style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(13,12,10,0.35) 0%, rgba(13,12,10,0.35) 100%), linear-gradient(0deg, #0d0c0a 0%, rgba(13,12,10,0) 45%, rgba(13,12,10,0) 70%, rgba(13,12,10,0.5) 100%);"
      >
      </div>

      <Header />

      <div style="position: absolute; left: 40px; bottom: 28px; z-index: 2;">
        <h1
          style="font-family: var(--km-font-mono); font-size: 30px; font-weight: 500; color: var(--km-title); margin: 0; text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 4px 20px rgba(0,0,0,0.9);"
        >
          Version
        </h1>
        <div class="eyebrow" style="margin-top: 4px; text-shadow: 0 1px 3px rgba(0,0,0,0.95), 0 4px 16px rgba(0,0,0,0.85);">
          Build &amp; release info
        </div>
      </div>
    </div>

    <main style="max-width: 720px; margin: 0 auto; padding: 56px 24px 96px; display: flex; flex-direction: column; gap: 12px;">
      <section>
        <h2 style="font-family: var(--km-font-body); font-size: 22px; color: var(--km-title); margin: 0;">This build</h2>
        <p style="color: var(--km-text-muted); margin: 8px 0 24px;">What this deployment of killmutants.io is.</p>

        <table style="width: 100%; border: 1px solid var(--km-border); border-radius: 6px; border-collapse: separate; background: var(--km-bg-panel); text-align: left;">
          <tbody>
            <tr>
              <th scope="row" style="padding: 12px 16px; color: var(--km-text-dim); font-weight: 500; white-space: nowrap; width: 1%;">Release</th>
              <td style="padding: 12px 16px; font-family: var(--km-font-mono); font-size: 13px; overflow-wrap: anywhere;">
                {version.release === null ? <span style="color: var(--km-text-dim);">{NOTHING}</span> : version.release}
              </td>
            </tr>
            <tr>
              <th scope="row" style="padding: 12px 16px; color: var(--km-text-dim); font-weight: 500; white-space: nowrap; width: 1%; border-top: 1px solid var(--km-border);">Commit</th>
              <td style="padding: 12px 16px; font-family: var(--km-font-mono); font-size: 13px; overflow-wrap: anywhere; border-top: 1px solid var(--km-border);">
                {
                  version.commit === null ? (
                    <span style="color: var(--km-text-dim);">{NOTHING}</span>
                  ) : (
                    <a href={commitUrl(version.commit)} target="_blank" rel="noopener noreferrer">
                      {version.commit}
                    </a>
                  )
                }
              </td>
            </tr>
            <tr>
              <th scope="row" style="padding: 12px 16px; color: var(--km-text-dim); font-weight: 500; white-space: nowrap; width: 1%; border-top: 1px solid var(--km-border);">Built</th>
              <td style="padding: 12px 16px; font-family: var(--km-font-mono); font-size: 13px; border-top: 1px solid var(--km-border);">
                <time datetime={version.built}>{version.built}</time>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <section style="margin-top: 48px;">
        <h2 style="font-family: var(--km-font-body); font-size: 20px; color: var(--km-title); margin: 0;">Latest release</h2>
        <p style="color: var(--km-text-muted); margin: 8px 0 24px;">What this site last shipped.</p>

        {
          siteRelease.latest === null ? (
            <p style="color: var(--km-text-dim); font-size: 14px;">
              Nothing has been tagged as a release yet — this site is still on its first, unreleased build.
            </p>
          ) : (
            <ReleaseCard release={siteRelease.latest} tagUrl={releaseUrl(siteRelease.latest.tag)} />
          )
        }
      </section>

      {
        siteRelease.previous.length > 0 && (
          <section style="margin-top: 48px;">
            <h2 style="font-family: var(--km-font-body); font-size: 20px; color: var(--km-title); margin: 0;">Previous releases</h2>
            <p style="color: var(--km-text-muted); margin: 8px 0 24px;">The releases published just before the latest one.</p>

            <div style="display: flex; flex-direction: column; gap: 16px;">
              {siteRelease.previous.map((release) => (
                <ReleaseCard release={release} />
              ))}
            </div>

            <p style="margin-top: 16px; font-size: 13px;">
              <a href={siteRelease.moreTag ? releaseUrl(siteRelease.moreTag) : releasesListUrl()} target="_blank" rel="noopener noreferrer">
                View more on GitHub &rarr;
              </a>
            </p>
          </section>
        )
      }
    </main>
  </body>
</html>
