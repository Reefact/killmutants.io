---
import Header from "./Header.astro";
import ReleaseCard from "./ReleaseCard.astro";
import versionHero from "@brand/version.png";
import { localeFromPath } from "../i18n/routing";
import { useTranslations } from "../i18n/ui";
import { commitUrl, version } from "../version";
import { previousSiteReleasesIn, releaseUrl, releasesListUrl, siteRelease, siteReleaseIn } from "../site-release";

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const NOTHING = "#null";
const latest = siteReleaseIn(locale);
const previous = previousSiteReleasesIn(locale);
---

<Header
  banner={{
    image: versionHero,
    title: t("version.title"),
    subtitle: t("version.subtitle"),
  }}
/>

<main style="max-width: 720px; margin: 0 auto; padding: 56px 24px 96px; display: flex; flex-direction: column; gap: 12px;">
  <section>
    <h2 style="font-family: var(--km-font-body); font-size: 22px; color: var(--km-title); margin: 0;">{t("version.thisBuild.heading")}</h2>
    <p style="color: var(--km-text-muted); margin: 8px 0 24px;">{t("version.thisBuild.lead")}</p>

    <table style="width: 100%; border: 1px solid var(--km-border); border-radius: 6px; border-collapse: separate; background: var(--km-bg-panel); text-align: left;">
      <tbody>
        <tr>
          <th scope="row" style="padding: 12px 16px; color: var(--km-text-dim); font-weight: 500; white-space: nowrap; width: 1%;">{t("version.release")}</th>
          <td style="padding: 12px 16px; font-family: var(--km-font-mono); font-size: 13px; overflow-wrap: anywhere;">
            {version.release === null ? <span style="color: var(--km-text-dim);">{NOTHING}</span> : version.release}
          </td>
        </tr>
        <tr>
          <th scope="row" style="padding: 12px 16px; color: var(--km-text-dim); font-weight: 500; white-space: nowrap; width: 1%; border-top: 1px solid var(--km-border);">{t("version.commit")}</th>
          <td style="padding: 12px 16px; font-family: var(--km-font-mono); font-size: 13px; overflow-wrap: anywhere; border-top: 1px solid var(--km-border);">
            {
              version.commit === null ? (
                <span style="color: var(--km-text-dim);">{NOTHING}</span>
              ) : (
                <a href={commitUrl(version.commit)} target="_blank" rel="noopener noreferrer">
                  {version.commit}
                </a>
              )
            }
          </td>
        </tr>
        <tr>
          <th scope="row" style="padding: 12px 16px; color: var(--km-text-dim); font-weight: 500; white-space: nowrap; width: 1%; border-top: 1px solid var(--km-border);">{t("version.built")}</th>
          <td style="padding: 12px 16px; font-family: var(--km-font-mono); font-size: 13px; border-top: 1px solid var(--km-border);">
            <time datetime={version.built}>{version.built}</time>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <section style="margin-top: 48px;">
    <h2 style="font-family: var(--km-font-body); font-size: 20px; color: var(--km-title); margin: 0;">{t("version.latest.heading")}</h2>
    <p style="color: var(--km-text-muted); margin: 8px 0 24px;">{t("version.latest.lead")}</p>

    {
      latest === null ? (
        <p style="color: var(--km-text-dim); font-size: 14px;">{t("version.noReleases")}</p>
      ) : (
        <ReleaseCard release={latest} tagUrl={releaseUrl(latest.tag)} />
      )
    }
  </section>

  {
    previous.length > 0 && (
      <section style="margin-top: 48px;">
        <h2 style="font-family: var(--km-font-body); font-size: 20px; color: var(--km-title); margin: 0;">{t("version.previous.heading")}</h2>
        <p style="color: var(--km-text-muted); margin: 8px 0 24px;">{t("version.previous.lead")}</p>

        <div style="display: flex; flex-direction: column; gap: 16px;">
          {previous.map((release) => (
            <ReleaseCard release={release} />
          ))}
        </div>

        <p style="margin-top: 16px; font-size: 13px;">
          <a href={siteRelease.moreTag ? releaseUrl(siteRelease.moreTag) : releasesListUrl()} target="_blank" rel="noopener noreferrer">
            {t("version.previous.viewMoreOnGithub")} &rarr;
          </a>
        </p>
      </section>
    )
  }
</main>
