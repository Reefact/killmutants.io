---
/**
 * The bar every page carries: the brand (always links home), then whatever
 * other content pages exist (none yet — they go here, always to the left of
 * GitHub), then GitHub, then the language selector. No "Home" link (the brand
 * already is one) and no link back to the current page.
 *
 * Desktop and mobile want a genuinely different reading order for the same
 * two focusable pieces — GitHub before the language selector on desktop
 * (`.nav-desktop`, the traditional arrangement), the language selector on the
 * brand's row with GitHub dropping to its own centered row below on mobile
 * (`.nav-mobile`) — and keyboard/AT tab order always follows DOM order, never
 * the CSS `order` property (learned the hard way: see the git history of this
 * file for two failed attempts at faking one visual order with a single DOM
 * order). So rather than one shared block reordered per breakpoint, this
 * renders BOTH orders and lets exactly one be present in the accessibility
 * tree at a time: `display: none` — unlike `visibility: hidden` — drops an
 * element and its descendants from that tree entirely, so the inactive
 * breakpoint's copy is never reachable by Tab, a screen reader, or anything
 * else. `display: contents` on the active copy's wrapper keeps its own box
 * out of layout while still letting its children act as direct flex items of
 * `.site-header` (needed for the mobile copy: its language selector must
 * share the brand's row and its nav links must wrap to their own row, which
 * only works if they're direct children of the header's own flex-wrap
 * context, not grandchildren of an extra wrapper box).
 *
 * Two ways a page uses this:
 * - `banner` set: Header owns a compact, fixed-height decorative banner (image,
 *   gradient fade, nav overlaid, a title block bottom-left) — the consistent
 *   treatment every "secondary" page (like /version) gets for free, instead of each
 *   one reinventing its own height and fade. `banner.title`/`banner.subtitle` are
 *   already translated by the caller (`useTranslations(locale)`).
 * - `banner` omitted: just the nav bar, `transparent` (default true) for a page
 *   building its own hero underneath it (only the home page does this today, since
 *   its hero is the page's primary content — full-height, not a decorative strip —
 *   and doesn't fit this component's fixed banner shape).
 *
 * `githubLink` (default true) drops the header's own GitHub link when a page
 * already carries a more prominent one of its own — the home page's "Star on
 * GitHub" button — so the same destination isn't offered twice.
 */
import HeroBackground from "./HeroBackground.astro";
import LanguageSelector from "./LanguageSelector.astro";
import { localeFromPath, pathForLocale } from "../i18n/routing";
import { useTranslations } from "../i18n/ui";
import { site } from "../site";

interface Banner {
  /** The brand original, imported (e.g. `import hero from "@brand/version.png"`),
   *  not a URL: importing it is what puts it through `astro:assets`, so the
   *  banner gets a whole ladder of sizes and formats instead of one fixed file. */
  image: ImageMetadata;
  title: string;
  subtitle: string;
}

interface Props {
  transparent?: boolean;
  banner?: Banner;
  githubLink?: boolean;
}

const { transparent = true, banner, githubLink = true } = Astro.props;

const pathname = Astro.url.pathname;
const locale = localeFromPath(pathname);
const t = useTranslations(locale);
const homeHref = pathForLocale("/", locale);
---

{
  banner ? (
    <div class="hero-banner">
      {/* `300px` — `.hero-banner`'s own fixed height below; see
          HeroBackground.astro on why that height is what decides how wide the
          artwork actually gets painted. */}
      <HeroBackground image={banner.image} boxHeight="300px" objectPosition="left center" opacity={0.75} />
      <div class="fade" />

      <header class="site-header overlaid">
        <a class="brand" href={homeHref}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b026ff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.5c-4.1 0-7.2 3-7.2 7v4.2c0 1.1.6 2.1 1.6 2.6L5 20h3.2l.9-1.8h5.8l.9 1.8H19l-1.4-3.7c1-.5 1.6-1.5 1.6-2.6V9.5c0-4-3.1-7-7.2-7Z" />
            <path d="M8.7 9.8 10.3 11.4M10.3 9.8 8.7 11.4" />
            <path d="M15.3 9.8 13.7 11.4M13.7 9.8 15.3 11.4" />
          </svg>
          KILLMUTANTS
        </a>

        <div class="nav-mobile">
          <LanguageSelector pathname={pathname} />
          {githubLink && (
            <nav class="nav-links" aria-label={t("nav.primary")}>
              <!-- Other content pages (Docs, etc.) go here, always to the left of GitHub. None exist yet. -->
              <a href={site.repository} target="_blank" rel="noopener noreferrer">
                {t("nav.github")}
              </a>
            </nav>
          )}
        </div>

        <div class="nav-desktop">
          {githubLink && (
            <>
              <nav class="nav-links" aria-label={t("nav.primary")}>
                <!-- Other content pages (Docs, etc.) go here, always to the left of GitHub. None exist yet. -->
                <a href={site.repository} target="_blank" rel="noopener noreferrer">
                  {t("nav.github")}
                </a>
              </nav>
              <span class="nav-divider" aria-hidden="true" />
            </>
          )}
          <LanguageSelector pathname={pathname} />
        </div>
      </header>

      <div class="banner-title">
        <h1>{banner.title}</h1>
        <div class="eyebrow">{banner.subtitle}</div>
      </div>
    </div>
  ) : (
    <header class={transparent ? "site-header overlaid" : "site-header"}>
      <a class="brand" href={homeHref}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b026ff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2.5c-4.1 0-7.2 3-7.2 7v4.2c0 1.1.6 2.1 1.6 2.6L5 20h3.2l.9-1.8h5.8l.9 1.8H19l-1.4-3.7c1-.5 1.6-1.5 1.6-2.6V9.5c0-4-3.1-7-7.2-7Z" />
          <path d="M8.7 9.8 10.3 11.4M10.3 9.8 8.7 11.4" />
          <path d="M15.3 9.8 13.7 11.4M13.7 9.8 15.3 11.4" />
        </svg>
        KILLMUTANTS
      </a>

      <div class="nav-mobile">
        <LanguageSelector pathname={pathname} />
        {githubLink && (
          <nav class="nav-links" aria-label={t("nav.primary")}>
            <!-- Other content pages (Docs, etc.) go here, always to the left of GitHub. None exist yet. -->
            <a href={site.repository} target="_blank" rel="noopener noreferrer">
              {t("nav.github")}
            </a>
          </nav>
        )}
      </div>

      <div class="nav-desktop">
        {githubLink && (
          <>
            <nav class="nav-links" aria-label={t("nav.primary")}>
              <!-- Other content pages (Docs, etc.) go here, always to the left of GitHub. None exist yet. -->
              <a href={site.repository} target="_blank" rel="noopener noreferrer">
                {t("nav.github")}
              </a>
            </nav>
            <span class="nav-divider" aria-hidden="true" />
          </>
        )}
        <LanguageSelector pathname={pathname} />
      </div>
    </header>
  )
}

<style define:vars={{ overlaidShadow: "0 1px 3px rgba(0,0,0,0.9), 0 3px 14px rgba(0,0,0,0.75)" }}>
  .hero-banner {
    position: relative;
    height: 300px;
    overflow: hidden;
  }

  .hero-banner .fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 12, 10, 0.35) 0%, rgba(13, 12, 10, 0.35) 100%),
      linear-gradient(0deg, #0d0c0a 0%, rgba(13, 12, 10, 0) 45%, rgba(13, 12, 10, 0) 70%, rgba(13, 12, 10, 0.5) 100%);
  }

  .banner-title {
    position: absolute;
    left: 40px;
    bottom: 28px;
    z-index: 2;
  }

  .banner-title h1 {
    font-family: var(--km-font-mono);
    font-size: 30px;
    font-weight: 500;
    color: var(--km-title);
    margin: 0;
    text-shadow: var(--overlaidShadow);
  }

  .banner-title .eyebrow {
    margin-top: 4px;
    text-shadow: var(--overlaidShadow);
  }

  .site-header {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px 40px;
    font-family: var(--km-font-mono);
    font-size: 13px;
  }

  .site-header:not(.overlaid) {
    background: var(--km-bg-panel);
    border-bottom: 1px solid var(--km-border);
  }

  .site-header.overlaid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  .site-header.overlaid .brand,
  .site-header.overlaid .nav-links,
  .site-header.overlaid :global(.language-selector) {
    text-shadow: var(--overlaidShadow);
  }

  /* Exactly one of these is ever in the accessibility tree — see the top-of-file
   * comment for why both a desktop and a mobile order exist at all. `contents`
   * on the active one keeps its own box out of layout while its children still
   * act as direct flex items of `.site-header`; `none` on the inactive one
   * removes it and its descendants from layout, focus order and AT alike. */
  .nav-mobile {
    display: none;
  }

  .nav-desktop {
    display: contents;
  }

  @media (max-width: 480px) {
    .nav-mobile {
      display: contents;
    }

    .nav-desktop {
      display: none;
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    letter-spacing: 0.04em;
    font-weight: 500;
    color: var(--km-title) !important;
  }

  .brand:hover {
    color: var(--km-title) !important;
  }

  .site-header.overlaid .brand:hover {
    text-shadow: var(--overlaidShadow), 0 0 16px rgba(176, 38, 255, 0.5);
  }

  .site-header:not(.overlaid) .brand:hover {
    text-shadow: 0 0 16px rgba(176, 38, 255, 0.5);
  }

  /* Each copy pushes the first element of its own group to the right of the
   * brand, so the rest of that group (divider + language selector on desktop;
   * nothing after it on mobile) trails along right next to it. When a page
   * hides the GitHub link (`githubLink={false}`), the language selector is
   * `.nav-desktop`'s only child — hence :first-child — so it needs the push
   * itself instead of trailing after the now-absent nav-links. */
  .nav-desktop .nav-links,
  .nav-desktop :global(.language-selector):first-child {
    margin-left: auto;
  }

  .nav-mobile :global(.language-selector) {
    margin-left: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-links a {
    color: var(--km-text-dim);
  }

  /* `.nav-links a`'s own color above already outweighs the site-wide `a:hover` glow
   * (its scoped attribute selector makes it more specific), so without this the
   * header's links never light up on hover the way every other link on the site does. */
  .nav-links a:hover {
    color: var(--km-mutant-violet-bright);
  }

  .site-header.overlaid .nav-links a:hover {
    text-shadow: var(--overlaidShadow), 0 0 10px rgba(197, 82, 255, 0.55);
  }

  .site-header:not(.overlaid) .nav-links a:hover {
    text-shadow: 0 0 10px rgba(197, 82, 255, 0.55);
  }

  .nav-divider {
    width: 1px;
    height: 16px;
    background: var(--km-border);
  }

  /* Below this, brand + language selector + nav-links no longer fit on one line.
   * Keep the language selector on the brand's row (right-aligned) and drop the
   * nav links (GitHub, future Docs links, …) to their own centered row below,
   * instead of clipping or overlapping the brand. (`.nav-desktop`'s divider
   * needs no separate hiding here — it's gone the moment `.nav-desktop` itself
   * switches to `display: none` above.) */
  @media (max-width: 480px) {
    .site-header {
      padding: 16px 20px;
      flex-wrap: wrap;
      row-gap: 10px;
    }

    .nav-mobile .nav-links {
      flex-basis: 100%;
      margin-top: 13px;
      justify-content: center;
    }
  }
</style>
