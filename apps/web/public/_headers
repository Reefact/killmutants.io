# HTML is always revalidated, so a redeploy is visible immediately instead of
# being served from a stale cached copy (same approach as justdummies.io).
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# version.json answers "what is live right now" — a cached copy would answer "what
# was live when you last asked", which is the one answer it must never give.
/version.json
  Cache-Control: no-store

# Everything astro:assets emits under /_astro/ carries a content hash in its
# filename — a changed file is a changed name, never the same name with new
# bytes — so there is no such thing as a stale copy to guard against. These are
# also the site's heaviest downloads (the hero artwork, in several sizes and
# formats), which is exactly what a year-long immutable cache is for.
#
# `immutable` is a promise to hold these bytes for a year without ever asking
# again, so it is only as good as that hash. Astro's own hash does NOT cover
# `image.service.config`, where the encoder settings live, which made this
# header a lie: changing avif.quality rebuilt the same filename with a
# different image, and anyone holding the URL would have kept the old one all
# year. apps/web/image-service/sharp.mjs closes that hole — read it before
# touching either this rule or those settings.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
