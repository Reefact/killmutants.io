# HTML is always revalidated, so a redeploy is visible immediately instead of
# being served from a stale cached copy (same approach as justdummies.io).
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# version.json answers "what is live right now" — a cached copy would answer "what
# was live when you last asked", which is the one answer it must never give.
/version.json
  Cache-Control: no-store
